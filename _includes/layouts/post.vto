---
layout: layouts/base.vto
---
<article>
  <p class="page-label">Journal</p>
  <h1 class="page-title">{{ title }}</h1>
  <p class="post-meta"><time datetime="{{ date.toISOString() }}">{{ date.toLocaleDateString('en-CH', { year: 'numeric', month: 'long', day: 'numeric' }) }}</time></p>
  {{ if image }}<img class="post-image" src="{{ image }}" alt="">{{ /if }}
  <div class="measure-34">{{ content |> safe }}</div>
  {{ if tags }}<p class="tags">{{ for tag of tags }}<span>{{ tag }}</span>{{ /for }}</p>{{ /if }}
</article>
