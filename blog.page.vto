---
layout: layouts/base.vto
title: Journal
description: Notes from On Words about clear, confident English.
url: /blog/
---
<section class="page shell">
  <p class="eyebrow">Journal</p>
  <h1>Notes on words that work.</h1>
  <div class="post-list">
    {{ if search.pages("type=post").length }}
    {{ for post of search.pages("type=post", "date=desc") }}
    <article>
      <p class="post-meta"><time datetime="{{ post.date.toISOString() }}">{{ post.date.toLocaleDateString('en-CH', { year: 'numeric', month: 'long', day: 'numeric' }) }}</time></p>
      <h2><a href="{{ post.url }}">{{ post.title }}</a></h2>
      <p>{{ post.description }}</p>
      <a class="text-link" href="{{ post.url }}">Read article <span aria-hidden="true">→</span></a>
    </article>
    {{ /for }}
    {{ else }}
    <p class="empty-state">The journal is taking shape. Please check back soon.</p>
    {{ /if }}
  </div>
</section>
