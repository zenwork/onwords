{
  "imports": {
    "lume/": "https://cdn.jsdelivr.net/gh/lumeland/lume@3.2.6/",
    "lume/cms/": "https://cdn.jsdelivr.net/gh/lumeland/cms@0.15.7/"
  },
  "tasks": {
    "lume": "deno run --allow-read --allow-write --allow-net --allow-env --allow-sys=networkInterfaces lume/cli.ts",
    "build": "deno task lume",
    "serve": "deno run --allow-read --allow-write --allow-net --allow-env serve.ts",
    "start": "deno task serve",
    "cms": "deno run --allow-read --allow-write --allow-net --allow-env --allow-run --allow-sys=networkInterfaces cms.ts",
    "cms:github": "deno task lume --serve",
    "test": "deno test --allow-read --allow-write --allow-run --allow-net"
  },
  "compilerOptions": {
    "types": ["lume/types.ts"]
  },
  "fmt": {
    "options": {
      "semiColons": false,
      "singleQuote": true,
      "lineWidth": 140,
      "indentWidth": 2,
      "proseWrap": "always",
      "useTabs": false
    }
  },
  "lint": {
    "rules": {
      "exclude": ["no-explicit-any", "no-import-prefix"]
    }
  }
}
